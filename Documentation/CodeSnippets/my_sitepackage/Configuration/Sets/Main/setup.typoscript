page = PAGE
page {
  10 = PAGEVIEW
  10 {
    paths.10 = EXT:my_sitepackage/Resources/Private/Templates/

    dataProcessing {
      10 = page-content

      20 = language-menu
      20 {
        languages = auto
        as = languagenavigation
      }
    }
  }

  20 = TEXT
  20.data = LLL:EXT:theme_camino/Resources/Private/Language/messages.xlf:menu.label
}
